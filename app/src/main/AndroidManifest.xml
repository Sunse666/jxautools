<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 抢课前台服务与通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 抢课定时触发（Android 12+ 需用户在设置中授予精确闹钟；未授予时降级为非精确并明示） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!--
      重启后重建闹钟。之前缺这条权限也缺接收器 → 设备重启后 AlarmManager 里的闹钟
      全部丢失，定时抢课静默失效（用户以为还挂着）。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Android 11+ 的包可见性过滤：不声明的话 `queryIntentActivities` 看不见别的包，
      导出 .ics 前那次「有没有 App 能打开日历文件」的预检会**恒为空** ——
      结果是真有日历 App 的真机上反而谎报「这台设备上没有能导入 .ics 的应用」。
      这里声明的 intent 必须与 ExamScreen.shareIcs 查询的那个一致。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/calendar" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JxauTools">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.RushService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".service.RushAlarmReceiver"
            android:exported="false" />

        <!--
          重启 / 应用更新 / 系统时间变化后重排闹钟。这几个都是**受保护广播**（只有系统能发），
          所以 exported="true" 不会带来伪造风险；写成 false 反而有收不到的风险，
          而「收不到」在这里等于定时抢课静默失效。

          ⚠️ **故意不声明 `LOCKED_BOOT_COMPLETED`**：direct boot 阶段（用户解锁前）
          credential-encrypted 存储不可读，`shared_prefs` 会拿到空数据 →
          `restorePending` 读到 0、静默返回，闹钟补不回来；而解锁快的时候又能读到，
          表现为**随机的成功/失败**。抢课本来就需要已登录的会话（同样在那个存储里），
          在 direct boot 阶段排闹钟没有意义 —— 只声明解锁后的 `BOOT_COMPLETED`，
          把竞态从设计里去掉。实测记录见 `docs/工程踩坑总表.md` §7.5。
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          导出考试安排为 .ics 时把文件分享给日历 / 邮件 / 微信。
          文件放 cache/ics/ 下靠 FileProvider 授权，**不需要任何存储权限**
          （Android 10+ 分区存储下也不该去要 WRITE_EXTERNAL_STORAGE）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
