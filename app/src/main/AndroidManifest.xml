<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      课表底图的兜底读权限，**仅 Android 12 及以下生效**（maxSdkVersion=32，
      13+ 的 photo picker 无需任何权限，本条自动消失）。
      为什么需要：MuMu 12 实测（2026-09-24）photo picker 回落的 DocumentsUI 返回
      media.documents URI，AMS 授权在、元数据可查，但 MediaProvider 的四条流式
      读取入口全部静默返回 null（不抛异常）——该 ROM 的 media 模块不认选图授权。
      持有 READ 权限时可退到 `_data` 物理路径经 FUSE 直读（见 TimetableBgStore
      的 openImageStream 末端绕行）。正常设备上选图走 picker，永远用不到这条权限。
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
      去抢课分支（2026-09-23）移除了这五条权限：
        · FOREGROUND_SERVICE / FOREGROUND_SERVICE_DATA_SYNC / POST_NOTIFICATIONS
          —— 只为 RushService 的前台进度通知而申请，删掉抢课后本工程不再发任何通知
             （全工程 `NotificationCompat` / `NotificationManager` 零引用）；
        · SCHEDULE_EXACT_ALARM / RECEIVE_BOOT_COMPLETED
          —— 只为抢课定时与 BootReceiver 重建闹钟而申请，两者已连同功能删除。
      现在权限面只剩「联网 + 网络状态」两项，安装时的权限提示也只剩这两条。
    -->

    <!--
      Android 11+ 的包可见性过滤：不声明的话 `queryIntentActivities` 看不见别的包，
      导出 .ics 前那次「有没有 App 能打开日历文件」的预检会**恒为空** ——
      结果是真有日历 App 的真机上反而谎报「这台设备上没有能导入 .ics 的应用」。
      这里声明的 intent 必须与 ExamScreen.shareIcs 查询的那个一致。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/calendar" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JxauTools">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          去抢课分支移除了 `<service .service.RushService>`（前台抢课服务）、
          `<receiver .service.RushAlarmReceiver>`（闹钟触发）与
          `<receiver .service.BootReceiver>`（重启/更新/改时间后重建闹钟）三个组件。
          随之消失的还有 `docs/工程踩坑总表.md` §7.5 那条 direct boot 竞态 ——
          竞态的存在前提是「需要在解锁前读 shared_prefs 排闹钟」，抢课没了前提也就没了。
          原实现与实测记录见 Pro 版（`D:\IO\Android\jxautools Pro`）与 git 历史。

          ⚠️ **别被合并后的清单吓到**（2026-09-23 实测核过）：本文件自己声明的
          `service` / `receiver` 现在是 **0 个**，但 `aapt dump xmltree` 打开发布包仍会看到
          1 个 receiver 与 2 个 provider —— 全是**依赖库注入**的，不是我们的遗留：
            · `androidx.profileinstaller.ProfileInstallReceiver`（受 `android.permission.DUMP`
              保护，只有 adb/shell 能触发）；
            · `androidx.startup.InitializationProvider`；
            · `androidx.core.content.FileProvider`（这个才是我们用的，见下）。
        -->

        <!--
          导出考试安排为 .ics 时把文件分享给日历 / 邮件 / 微信。
          文件放 cache/ics/ 下靠 FileProvider 授权，**不需要任何存储权限**
          （Android 10+ 分区存储下也不该去要 WRITE_EXTERNAL_STORAGE）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
